((benchmarkKind . scenario-e2e)
 (max_total . 5ms)
 (target_total . 1ms)
 (regression_budget . 4ms)
 (expected_over_input_budget . 250us)
 (targetRationale . "RS7 formatter core should stay in the sub-millisecond class for one source file.")
 (sampleCount . 20)
 (rule . GERBIL-SCHEME-FMT-RS7)
 (feature . rs7-basic-style)
 (optimizationFocus . "format core text normalization")
 (inputShape . "Gerbil source with trailing spaces, tabs, and trailing blank lines")
 (expectedOutcome . "formatted output matches the rs7-basic-style expected fixture")
 (measurementPhases . (collect-before collect-after policy-before policy-after assert-time-gate ))
 (tags . (format rs7 hot-path)))
