((benchmarkKind . scenario-e2e)
 (max_total . 300ms)
 (target_total . 150ms)
 (regression_budget . 150ms)
 (expected_over_input_budget . 100ms)
 (targetRationale
  .
  "The gambit-specialized-vector-storage target defines the optimization objective; max_total is the hard regression ceiling, and runtime observations belong only in measured receipts.")
 (sampleCount . 20)
 (purpose . "R013 teaches agents to choose Gambit specialized vectors for bytes and numeric arrays instead of boxed list/vector scaffolding")
 (feature . "gambit-specialized-vector-storage")
 (rule . "GERBIL-SCHEME-AGENT-POLICY-013")
 (optimizationFocus . "packed byte and numeric storage with specialized vector primitives")
 (inputShape
  .
  "large byte or numeric data is represented as lists, hash entries, or boxed generic vectors in a hot path")
 (expectedOutcome
  .
  "choose u8vector/f64vector or the matching specialized vector family, keep conversion at the boundary, and use length/ref/set/copy primitives in the hot lane")
 (expectedReferencePattern . "gambit-specialized-vector-storage")
 (expectedReferenceExamples
  "gambit://tests/unit-tests/07-vector/u8vector.scm#u8vector"
  "gambit://tests/unit-tests/07-vector/u8vector.scm#make-u8vector"
  "gambit://tests/unit-tests/13-modules/prim_f64vector.scm#f64vector")
 (expectedQualitySignals
  "packed-storage-choice"
  "boundary-conversion-only"
  "specialized-vector-primitives"
  "boxed-collection-elimination")
 (learnedStyleSources
  "gambit://tests/unit-tests/07-vector/u8vector.scm"
  "gambit://tests/unit-tests/13-modules/prim_f64vector.scm")
 (antiAiScaffoldIntent
  .
  "reject generated byte/numeric pipelines that allocate lists or boxed vectors where specialized Gambit vector storage is the native fast representation")
 (scenarioQualityAxes
  "gambit-specialized-vectors"
  "packed-storage-boundary"
  "hot-data-lane"
  "anti-ai-scaffold")
 (measurementPhases
  "collect-before"
  "collect-after"
  "policy-before"
  "policy-after"
  "assert-time-gate"
  )
 (tags "style" "gambit-native" "vector" "u8vector" "f64vector" "packed-storage"))
