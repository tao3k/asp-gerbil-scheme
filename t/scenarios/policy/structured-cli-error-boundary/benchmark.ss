((benchmarkKind . scenario-e2e)
 (max_total . 200ms)
 (target_total . 100ms)
 (regression_budget . 100ms)
 (expected_over_input_budget . 100ms)
 (targetRationale . "The structured error boundary uses a 100ms p95 target and equal regression headroom calibrated for end-to-end parser and policy execution.")
 (sampleCount . 20)
 (purpose . "Keep typed CLI error propagation and parser recovery within the scenario-owned timing gate")
 (rule . "GERBIL-SCHEME-AGENT-POLICY-CLI-ERROR-BOUNDARY-001")
 (feature . "structured-cli-error-boundary")
 (optimizationFocus . "typed command errors, exit handling, and parser error recovery")
 (inputShape . "one CLI command module mixes raw option failures, exit handling, and user-facing command errors")
 (expectedOutcome . "introduce a typed command error boundary and preserve structured error propagation through the CLI facade")
 (measurementPhases "collect-before" "collect-after" "policy-before" "policy-after" "assert-time-gate" )
