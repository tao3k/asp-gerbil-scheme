+;; SSI contains the compiler's loader calls and nested module declarations.
+;; Follow only those structural forms, never quoted data or import names.
+(def (native-outputs mod settings)
+  (def root (prefix/ (settings-prefix settings) (path-strip-extension mod)))
+  (def (object-path id)
+    (path-expand (string-append id ".o1") (settings-libdir settings)))
+  (def (owned? id)
+    (or (equal? root id) (string-prefix? (string-append root "~") id)))
+  (def (walk form owner)
+    (match form
+      ([(or '%#begin '%#begin-syntax) . forms]
+       (append-map (cut walk <> owner) forms))
+      (['%#module (? symbol? id) . forms]
+       (let (nested (string-append owner "~" (module-id->path-string id)))
+         (cons (object-path nested) (append-map (cut walk <> nested) forms))))
+      (['%#call ['%#ref 'load-module] ['%#quote (? string? id)]]
+       (if (owned? id) [(object-path id)] []))
+      (_ [])))
+  (call-with-input-file (library-path mod ".ssi" settings)
+    (lambda (port)
+      (let loop ((paths [(object-path root)]))
+        (let (form (read port))
+          (if (eof-object? form)
+            (delete-duplicates/hash paths)
+            (loop (append paths (walk form root)))))))))
+
+(def (native-receipt-path mod settings)
+  (library-path mod ".native-complete" settings))
+
+(def (native-receipt-key mod opts settings)
+  (list 'native-complete-v1 (gerbil-version-string) (gerbil-home)
+        (settings-srcdir settings) (settings-libdir settings) (settings-prefix settings)
+        (settings-optimize settings) (settings-debug settings)
+        (gsc-compile-opts opts) (gerbil-gsc)
+        (file-timestamp (source-path mod ".ss" settings))
+        (file-timestamp (library-path mod ".ssi" settings))))
+
+(def (gxc-native-current? mod opts settings)
+  (or (not (eq? (settings-target settings) 'C))
+      (with-catch false
+        (lambda ()
+          (call-with-input-file (native-receipt-path mod settings)
+            (lambda (port)
+              (and (equal? (read port) (native-receipt-key mod opts settings))
+                   (eof-object? (read port)))))))))
+
+(def (spec-native-current? spec settings)
+  (and (match spec
+         ((? string? mod) (gxc-native-current? mod #f settings))
+         ([gxc: mod . opts] (gxc-native-current? mod opts settings))
+         (_ #t))
+       (andmap (cut spec-native-current? <> settings) (spec-submodules spec))))
+
+(def (publish-native-receipts!)
+  ;; A queued gsc job is not a completed native library. This is called only
+  ;; after the executor has joined successfully; failures leave no receipt.
+  (for (entry (cdr (current-native-receipts)))
+    (match entry
+      ([mod opts settings]
+       (def paths (native-outputs mod settings))
+       (unless (andmap file-exists? paths)
+         (error "Incomplete native library outputs" mod paths))
+       (def receipt (native-receipt-path mod settings))
+       (def temporary (string-append receipt ".tmp"))
+       (when (file-exists? temporary) (delete-file temporary))
+       (call-with-output-file temporary
+         (lambda (port) (write (native-receipt-key mod opts settings) port)))
+       (rename-file temporary receipt)))))
+
 (def (gxc-outputs mod opts settings)
-  [(library-path mod ".ssi" settings)
-   (static-path mod settings)])
+  (append [(library-path mod ".ssi" settings) (static-path mod settings)]
+          (if (eq? (settings-target settings) 'C)
+            (cons (native-receipt-path mod settings)
+                  (with-catch (lambda (_) []) (cut native-outputs mod settings)))
+            [])))
 
