  "conclusions": {
    "rootAlias": "Two paths resolve to one claim directory; competing writer rejected with exit 70 and zero compilation",
    "descendantAlias": "Distinct canonical roots share physical module directory; claims do not exclude one another; B receipt/snapshots unchanged after A overwrites objects; runtime 43 to 42 and warm skips",
    "escapedBackends": "Frontend and direct wrappers die; two independently sessioned workers acknowledge after original group death",
    "groupOnlyReclamation": "Test-only removal of occupied claim permits B success followed by escaped A object overwrite; runtime 43 to 42",
    "privateGenerations": "Retain abandoned A claim; late A objects import as 42 only from A; pinned B reader remains 43; B object bytes and selector unchanged"
  },
  "evidenceBoundary": {
    "instrumentation": "Capture producer Scheme input and use real native gsc -o to original object path; explicit fork/setsid only in detached control",
    "notMeasured": "Natural race frequency or naturally detaching unmodified gsc",
    "temporaryActions": "All removed claims and killed process groups belong to the runner-owned temporary fixture",
    "publication": "Python harness atomically replaces a small selector only after B make succeeds; reader uses selected root in its environment",
    "reader": "Fresh process pinned to B root; two-object single-module fixture, installed dependencies outside generation",
    "authority": "Backend obeys supplied paths; no OS sandbox or malicious-backend confinement claimed"
  },
  "decisions": {
    "rootNormalization": "Do not treat distinct canonical roots as proof of disjoint writes",
    "recovery": "Do not reclaim from direct PID/original process-group absence alone",
    "direction": "Fresh producer generation plus separately fenced publication and pinned admitted readers",
    "retainedCompilerPatches": "Unchanged; no namespace claim or generation production implementation/deployment",
    "previousQualification": "81 probes qualified earlier exact source; not rerun or added to this study count"
  },
  "nextContracts": [
    "Allocate unique fresh output generation; do not recycle path while old jobs may write",
    "Publish only with current authority token; superseded live frontend cannot overwrite selector",
    "Admission binds completed generation and dependency closure",
    "Readers pin admitted generation for lifetime of lookup/module-cache scope",
    "Garbage collection requires independent writer-quiescence and reader-retention evidence",
    "Account for other target write paths and pathname replacement; observed aliases do not freeze them"
  ],
