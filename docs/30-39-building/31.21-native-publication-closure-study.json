  "conclusions": {
    "atomicReplaceOnly": "Old token 1 passes early check, pauses, then replaces token 2; fresh selected runtime 43 to 42",
    "lockedEpochCheck": "Old token 1 is rejected with exit 70 after token 2 publication; selector hash unchanged and fresh runtime 43",
    "pinnedRoot": "Fresh readers pinned to B return 43 even after unfenced selector regression",
    "rootReceiptOnly": "Entry receipt survives missing dependency; explicit alternate dependency search root permits import with 101",
    "closureAdmission": "Missing graph node, omitted dependency inventory, missing dependency files, changed dependency object rejected with previous selector unchanged",
    "completedClosure": "Two modules and 12 artifact hashes admitted; selected runtime 43; spent token rejected"
  },
  "evidenceBoundary": {
    "broker": "Cooperating grant and publication processes use one advisory flock on owned scratch storage",
    "authority": "New grant immediately supersedes older authority, even before new generation admission succeeds",
    "closure": "Fixed app->dep graph; installed runtime dependencies external; seal derived after successful build, not general dependency or receipt parser",
    "immutability": "Generation files assumed quiescent and stable during hashing and reading; no prevention of mutation or pathname replacement",
    "durability": "Authority and active selector are separate atomic file replacements without fsync; no interruption or power-loss consistency claim",
    "reader": "Each runtime is a fresh process with explicit load path; no live module cache switching or retention protocol",
    "fallback": "Missing dependency counterexample supplies an explicit fallback load root with a different dependency value",
    "trust": "Artifact hashes bind bytes but do not prove compiler provenance or authenticate broker clients",
    "count": "Earlier 81 compiler probes and 37 namespace observations were not rerun or counted"
  },
  "nextContracts": [
    "Crash-consistent authority and selector transaction with replay policy",
    "Parser/compiler-owned application dependency closure with explicit external dependency boundary",
    "Trusted completion admission and immutable generation storage",
    "Reader generation pinning and retention lifetime before storage reclamation"
  ],
