{
  "schemaId": "agent.semantic-protocols.hook.provider-manifest",
  "schemaVersion": "1",
  "protocolId": "agent.semantic-protocols.hook",
  "protocolVersion": "1",
  "manifestId": "agent.semantic-protocols.languages.gerbil-scheme.gerbil-scheme-harness",
  "manifestVersion": "v1",
  "languageId": "gerbil-scheme",
  "providerId": "gerbil-scheme-harness",
  "namespace": "agent.semantic-protocols.languages.gerbil-scheme.gerbil-scheme-harness",
  "binary": "gslph",
  "development": {
    "schemaId": "agent.semantic-protocols.provider-development-descriptor",
    "schemaVersion": "1",
    "sourceRoot": "languages/gerbil-scheme-language-project-harness",
    "buildBinding": "provider-workspace-install-v1",
    "workspaceInstall": "provider/asp-provider-workspace-install.json",
    "artifactDomain": "checkout"
  },
  "execution": "external-process",
  "languageProjection": {
    "schemaId": "agent.semantic-protocols.provider-language-projection-descriptor",
    "schemaVersion": "1",
    "commandBinding": "projection-batch-stdin",
    "transport": "framed-stdin-v1",
    "requestSchema": "https://schemas.agent-semantic-protocols.dev/provider-language-projection-batch-request.v1.schema.json",
    "responseSchema": "https://schemas.agent-semantic-protocols.dev/provider-language-projection-batch-response.v1.schema.json",
    "identitySchema": "https://schemas.agent-semantic-protocols.dev/canonical-language-item-identity.v1.schema.json"
  },
  "projectResolution": {
    "schemaId": "agent.semantic-protocols.provider-project-resolution-descriptor",
    "schemaVersion": "1",
    "capabilityId": "project-resolution",
    "entryMarkers": ["gerbil.pkg"],
    "sourceExtensions": [".ss", ".scm", ".sld"],
    "manifestKinds": ["gerbil-package"],
    "lockfileKinds": [],
    "parserId": "gerbil.package-spec",
    "commandBinding": "project-resolution-stdin",
    "requestSchema": "https://schemas.agent-semantic-protocols.dev/provider-project-resolution-request.v1.schema.json",
    "responseSchema": "https://schemas.agent-semantic-protocols.dev/provider-project-resolution-response.v1.schema.json",
    "packageGraphSchema": "https://schemas.agent-semantic-protocols.dev/language-package-graph.v1.schema.json",
    "projectResolutionSchema": "https://schemas.agent-semantic-protocols.dev/project-resolution.v1.schema.json"
  },
  "searchCapabilities": {
    "ownerItems": true,
    "semanticFacts": false,
    "dependencyTopology": true,
    "dependencyTopologyMetadata": false,
    "sourceSnapshot": {
      "descriptorId": "gerbil-scheme.source-snapshot",
      "descriptorVersion": "1",
      "languageId": "gerbil-scheme",
      "packetSchemaId": "asp.source-snapshot.v1",
      "exactSourcePacketSchemaId": "asp.exact-source-query-result.v1",
      "canonicalItemSelectorSchemaId": "asp.canonical-item-selector.v1",
      "sourceSnapshotEnvelopeSchemaId": "asp.exact-source-snapshot-envelope.v1",
      "derivedArtifactEvidenceSchemaId": "asp.derived-source-artifact-evidence.v1",
      "algorithm": "blake3-merkle-v1",
      "authority": "live-parser",
      "exactSelectorResolution": "pinned-live-module-graph",
      "overlayMode": "merkle-delta"
    }
  },
  "queryPackDescriptor": {
    "descriptorId": "gerbil-scheme.query-pack",
    "descriptorVersion": "1",
    "languageId": "gerbil-scheme",
    "termRoleOverrides": [],
    "recipes": [
      {
        "recipeId": "gerbil-fiber-runtime",
        "trigger": {"terms": ["fiber", "thread", "scheduling"], "match": "any"},
        "clauses": [
          {
            "terms": ["fiber", "thread", "scheduling"],
            "roles": ["concept"],
            "intentAxes": []
          }
        ]
      },
      {
        "recipeId": "gerbil-dynamic-wind-lifecycle",
        "trigger": {"terms": ["dynamic-wind", "resource", "lifecycle"], "match": "any"},
        "clauses": [
          {
            "terms": ["dynamic-wind", "resource", "lifecycle"],
            "roles": ["symbol", "concept"],
            "intentAxes": []
          }
        ]
      },
      {
        "recipeId": "gerbil-channel-stream",
        "trigger": {"terms": ["channel", "stream", "backpressure"], "match": "any"},
        "clauses": [
          {
            "terms": ["channel", "stream", "backpressure"],
            "roles": ["concept"],
            "intentAxes": []
          }
        ]
      }
    ]
  },
  "policy": {
    "directSourceRead": "block",
    "bulkSourceDump": "block",
    "rawSourceSearch": "block",
    "agentSearchJson": "block"
  },
  "routeBindings": {
    "prime": "search/prime",
    "dependencyTopology": "search/dependency-topology",
    "owner": "search/owner",
    "lexical": "search/lexical",
    "query": "query/exact-selector",
    "exactSelectorNative": "query/exact-selector-native-v1",
    "ingest": "search/ingest",
    "checkChanged": "check/changed",
    "guide": "guide"
  }
}
