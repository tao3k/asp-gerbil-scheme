{
  "$schema": "../schemas/provider-workspace-install.schema.json",
  "schemaId": "agent.semantic-protocols.provider-workspace-install",
  "schemaVersion": "1",
  "schemaAuthority": "https://tao3k.github.io/agent-semantic-protocols/schemas/",
  "languageId": "gerbil-scheme",
  "providerId": "asp-gerbil-scheme",
  "binary": "asp-gerbil-scheme",
  "providerRegistration": "asp-provider-registration.json",
  "schemaBundleReceipt": "../schemas/.asp-schema-manager-receipt.json",
  "workspaceArtifact": {
    "root": "languages/asp-gerbil-scheme/build/workspace-provider",
    "entrypoint": "bin/asp-gerbil-scheme"
  },
  "workspaceBuild": {
    "program": "/usr/bin/env",
    "args": [
      "-u",
      "SDKROOT",
      "gxi",
      "build.ss"
    ],
    "workingDirectory": "languages/asp-gerbil-scheme",
    "sourceSnapshotAnchors": [
      "languages/asp-gerbil-scheme/gerbil.pkg",
      "languages/asp-gerbil-scheme/manifest.ss",
      "languages/asp-gerbil-scheme/build.ss",
      "languages/asp-gerbil-scheme/src/building/native-toolchain.ss",
      "languages/asp-gerbil-scheme/src/parser/model.ss",
      "languages/asp-gerbil-scheme/src/parser/selectors.ss",
      "languages/asp-gerbil-scheme/src/parser/support.ss",
      "languages/asp-gerbil-scheme/src/parser/formals.ss",
      "languages/asp-gerbil-scheme/src/parser/syntax-support.ss",
      "languages/asp-gerbil-scheme/src/parser/definition-syntax.ss",
      "languages/asp-gerbil-scheme/src/parser/exact-owner.ss",
      "languages/asp-gerbil-scheme/src/commands/projection-batch.ss",
      "languages/asp-gerbil-scheme/src/parser/package.ss",
      "languages/asp-gerbil-scheme/src/protocol/command-catalog.ss",
      "languages/asp-gerbil-scheme/src/constants.ss",
      "languages/asp-gerbil-scheme/src/commands/project-resolution.ss",
      "languages/asp-gerbil-scheme/src/commands/provider-runtime.ss",
      "languages/asp-gerbil-scheme/src/runtime/provider-operation.ss",
      "languages/asp-gerbil-scheme/src/runtime/provider-http-json-server.ss",
      "languages/asp-gerbil-scheme/src/provider-server.ss"
    ],
    "derivedPaths": [
      "languages/asp-gerbil-scheme/build/workspace-provider"
    ],
    "env": {
      "ASP_PROVIDER_ARTIFACT_ROOT": "${ASP_WORKSPACE_ROOT}/languages/asp-gerbil-scheme/build/workspace-provider",
      "GERBIL_PATH": "${ASP_WORKSPACE_ROOT}/languages/asp-gerbil-scheme/.gerbil",
      "GERBIL_LOADPATH": "${ASP_WORKSPACE_ROOT}/languages/asp-gerbil-scheme/.gerbil/lib"
    }
  }
}
