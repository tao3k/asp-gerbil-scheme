{
  "schemaId": "agent.semantic-protocols.provider-workspace-install",
  "schemaVersion": "1",
  "schemaAuthority": "https://tao3k.github.io/agent-semantic-protocols/schemas/",
  "providerId": "gerbil-scheme-harness",
  "binary": "gslph",
  "workspaceArtifact": {
    "root": "languages/gerbil-scheme-language-project-harness/build/workspace-provider",
    "entrypoint": "bin/gslph"
  },
  "workspaceBuild": {
    "program": "gxi",
    "args": [
      "provider/workspace-build.ss"
    ],
    "workingDirectory": "languages/gerbil-scheme-language-project-harness",
    "sourceSnapshotAnchors": [
      "languages/gerbil-scheme-language-project-harness/gerbil.pkg",
      "languages/gerbil-scheme-language-project-harness/manifest.ss",
      "languages/gerbil-scheme-language-project-harness/build.ss",
      "languages/gerbil-scheme-language-project-harness/provider/workspace-build.ss"
    ],
    "derivedPaths": [
      "languages/gerbil-scheme-language-project-harness/build/workspace-provider"
    ],
    "env": {
      "GERBIL_PATH": "${ASP_WORKSPACE_ROOT}/languages/gerbil-scheme-language-project-harness/.gerbil",
      "GSLPH_WORKSPACE_ARTIFACT_ROOT": "${ASP_WORKSPACE_ROOT}/languages/gerbil-scheme-language-project-harness/build/workspace-provider"
    }
  }
}
